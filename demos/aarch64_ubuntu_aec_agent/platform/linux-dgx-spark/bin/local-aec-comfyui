#!/usr/bin/env bash
set -euo pipefail

ROOT="${LOCAL_AEC_COMFYUI_ROOT:-$HOME/local-aec-runtime/comfyui}"
cd "$ROOT/ComfyUI"
exec "$ROOT/comfyui-env/bin/python" main.py \
  --listen 127.0.0.1 \
  --port 8188 \
  --disable-auto-launch \
  --cache-none \
  --lowvram \
  --reserve-vram 48 \
  --preview-method none
